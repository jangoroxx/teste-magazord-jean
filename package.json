{
  "name": "magazord-quality-test-jean",
  "version": "1.0.0",
  "description": "Teste técnico - Coordenador de Qualidade (Magazord)",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:parte1": "playwright test --project=parte1-api",
    "test:parte2": "playwright test --project=parte2-e2e",
    "test:parte3": "playwright test --project=parte3-arquivos",
    "test:unit": "playwright test --grep \"\\[unit\\]|\\[mock\\]\"",
    "report": "playwright show-report",
    "postinstall": "playwright install chromium"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.65.1"
  }
}
